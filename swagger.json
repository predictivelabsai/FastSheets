                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "FastSME API token": []
          }
        ],
        "summary": "Create a workbooks record",
        "tags": [
          "Workbooks"
        ]
      }
    },
